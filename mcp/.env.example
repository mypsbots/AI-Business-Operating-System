# AIBOS MCP server configuration.
# Copy to `.env` (kept out of git) and adjust. All values are optional;
# sensible defaults let the server run locally with zero external services.

# ---------------------------------------------------------------------------
# Search backend: "local" (SQLite full-text, no external service) or
# "pinecone" (managed semantic search). If unset, the server uses "pinecone"
# when PINECONE_API_KEY is present, otherwise "local".
# ---------------------------------------------------------------------------
AIBOS_BACKEND=local

# ---------------------------------------------------------------------------
# Transport: "stdio" (local IDE clients) or "http" (remote/team clients such
# as ChatGPT, Gemini, Grok, your own app). Defaults to "stdio".
# ---------------------------------------------------------------------------
AIBOS_MCP_TRANSPORT=stdio

# Remote HTTP transport settings (only used when AIBOS_MCP_TRANSPORT=http).
AIBOS_MCP_HOST=0.0.0.0
AIBOS_MCP_PORT=8000
# Bearer token required on every remote request. STRONGLY recommended for the
# private/proprietary content — leave empty only for trusted localhost use.
# Generate with: openssl rand -hex 32
AIBOS_MCP_TOKEN=

# Per-agent / per-client tokens (recommended). Comma-separated `label:token`
# entries; each client sends `Authorization: Bearer <its-token>`. The matched
# label is logged on every request (audit) and a token is revoked by removing
# its entry and redeploying — without affecting the other clients. Takes
# precedence over AIBOS_MCP_TOKEN, which is still honoured as label "primary".
#   AIBOS_MCP_TOKENS=primary:<token-a>,hermes:<token-b>,cursor:<token-c>
AIBOS_MCP_TOKENS=

# ---------------------------------------------------------------------------
# Pinecone (only used when AIBOS_BACKEND=pinecone).
# ---------------------------------------------------------------------------
PINECONE_API_KEY=
AIBOS_PINECONE_INDEX=aibos-knowledge
AIBOS_PINECONE_NAMESPACE=aibos
AIBOS_PINECONE_CLOUD=aws
AIBOS_PINECONE_REGION=us-east-1
AIBOS_PINECONE_EMBED_MODEL=llama-text-embed-v2

# ---------------------------------------------------------------------------
# Local backend index location (SQLite file). Defaults to mcp/.index/aibos.db
# ---------------------------------------------------------------------------
AIBOS_LOCAL_INDEX=
